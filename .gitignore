# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
*.swp
*.swo
*~

# Node dependencies (node_modules excluded; package.json committed for devDependencies)
node_modules/

# Test data (never commit user consumption data)
test-data/*
!test-data/noise-config.json
*.csv
!docs/**/*.csv

# Environment
.env
.env.local

# Bake working directories (not shipped)
bake-output/
bake-input/
bake-test-tmp/

# Shipped demo files (exempt from *.csv exclusion)
!data/demos/*.csv
!data/demos/*.json

# M2 reference rate tables (canonical source for JS constants; committed)
!data/agile-regional-rates.csv
!data/regional-standing-charges.csv

# Committable noise calibration output (exempt from test-data/ exclusion)
!test-data/noise-config.json
