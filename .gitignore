# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
*.swp
*.swo
*~

# Node dependencies (never committed; no package.json — installed ad-hoc when needed)
node_modules/

# Test data (never commit user consumption data)
test-data/*
!test-data/noise-config.json
*.csv
!docs/**/*.csv

# Environment
.env
.env.local

# Bake working directories (not shipped)
bake-output/
bake-input/
bake-test-tmp/

# Shipped demo files (exempt from *.csv exclusion)
!data/demos/*.csv
!data/demos/*.json

# Committable noise calibration output (exempt from test-data/ exclusion)
!test-data/noise-config.json
